# Mesmas regras do vercel.json, para o site se comportar igual no Docker.
# Modelo da imagem oficial do nginx: ${API_URL} é preenchido com a variável de ambiente quando o container sobe
server {
  listen 80;
  root /usr/share/nginx/html;

  # Segurança (iguais aos do vercel.json): o site não pode ser embutido em outra página (clickjacking),
  # o navegador não adivinha tipos de arquivo, links externos não recebem a URL completa
  # e câmera, microfone e localização ficam desligados
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # A API pelo endereço do próprio site, como na Vercel: o cookie da sessão fica sendo do site.
  # A barra no fim do proxy_pass tira o prefixo: /api/carro chega na API como /carro
  location /api/ {
    proxy_pass ${API_URL}/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Rotas do React (/carros/123, /conta...) não existem como arquivo: entregam o index.html
  location / {
    try_files $uri /index.html;
  }

  # Arquivos do build têm o conteúdo no nome: podem ficar em cache por um ano
  # No nginx, um add_header dentro do location descarta os do server: por isso os de segurança se repetem aqui
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  }

  gzip on;
  gzip_types text/css application/javascript image/svg+xml;
}
