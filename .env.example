# URL da API Spring Boot
VITE_API_URL=http://localhost:8080

# Chave publicável da Stripe (pk_test_... em desenvolvimento). Coloque a sua em .env.development.local
VITE_STRIPE_PUBLISHABLE_KEY=

# Minutos que a reserva dura sem pagamento (padrão: 30). Precisa bater com compra.expiracao.tempo da API
VITE_RESERVA_MINUTOS=30
